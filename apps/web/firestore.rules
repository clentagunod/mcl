rules_version = '2';

// MCL Dashboard - Firestore security rules
//
// Roles live in the "users" collection (document id = Firebase Auth uid):
//   { role: "admin" | "collector" | "developer", active: boolean, ... }
//
// The FIRST admin document must be created by hand in the Firebase Console
// (see README). Active admins can then manage collector and admin profiles.
// Developer profiles are managed only through privileged Console/Admin SDK access.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath(request.auth.uid));
    }

    function profile() {
      return get(profilePath(request.auth.uid)).data;
    }

    function isAdmin() {
      return hasProfile() && profile().role in ['admin', 'developer']
        && profile().get('active', true) == true;
    }

    function isActiveCollector() {
      return hasProfile()
        && profile().role == 'collector'
        && profile().get('active', true) == true;
    }

    // A payment entry as the collector app is allowed to create it.
    function meetsCollectorMinimum(d) {
      let policyPath = /databases/$(database)/documents/settings/Configurations/elements/paymentPolicy;
      return !exists(policyPath)
        || get(policyPath).data.get('enforceDailyMinimum', false) != true
        || d.amount >= dailyMinimum(d.clientId);
    }

    function dailyMinimum(clientId) {
      let c = get(/databases/$(database)/documents/clients/$(clientId)).data;
      let saved = c.get('dailyAmount', 0);
      return saved is number && saved > 0 ? saved
        : math.ceil((c.principal + c.interest) * 100.0 / c.loanTermDays) / 100.0;
    }

    function validMoney(amount) {
      return amount is number && amount > 0 && amount <= 999999999
        && math.round(amount * 100) / 100.0 == amount;
    }

    function validPaymentDate(value, clientId) {
      let parts = value.split('-');
      let year = int(parts[0]);
      let month = int(parts[1]);
      let day = int(parts[2]);
      let date = timestamp.date(year, month, day);
      let c = get(/databases/$(database)/documents/clients/$(clientId)).data;
      return value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && date.year() == year && date.month() == month && date.day() == day
        && value >= c.get('approvalDate', '0001-01-01')
        // The lending business uses UTC+8, including near UTC midnight.
        && date <= (request.time + duration.value(8, 'h')).date();
    }

    function validReceiptFields(d) {
      return d.keys().hasAll(['clientId', 'amount', 'paymentDate', 'collectorId', 'collectorName', 'createdAt'])
        && d.clientId is string
        && exists(/databases/$(database)/documents/clients/$(d.clientId))
        && validMoney(d.amount)
        && d.paymentDate is string && validPaymentDate(d.paymentDate, d.clientId)
        && d.collectorId is string && d.collectorName is string
        && d.createdAt is timestamp
        && (!('loanId' in d) || d.loanId is string)
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 1500))
        && (!('note' in d) || (d.note is string && d.note.size() <= 1500));
    }

    function isValidNewPayment() {
      let d = request.resource.data;
      return d.keys().hasOnly(['clientId', 'amount', 'paymentDate', 'collectorId', 'collectorName', 'createdAt', 'notes', 'note', 'loanId'])
        && d.keys().hasAll(['clientId', 'amount', 'paymentDate', 'collectorId', 'collectorName', 'createdAt'])
        && d.clientId is string
        && exists(/databases/$(database)/documents/clients/$(d.clientId))
        && validMoney(d.amount)
        && meetsCollectorMinimum(d)
        && d.paymentDate is string
        && d.paymentDate.size() == 10
        && d.collectorId == request.auth.uid
        && d.collectorName is string
        && d.collectorName == profile().get('fullName', '')
        && d.createdAt == request.time
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 1500))
        && (!('note' in d) || (d.note is string && d.note.size() <= 1500));
    }

    function currentLoanReceipt(d) {
      let c = get(/databases/$(database)/documents/clients/$(d.clientId)).data;
      return d.get('loanId', 'initial') == c.get('activeLoanId', 'initial');
    }

    function validCycleReceipt(d) {
      let c = get(/databases/$(database)/documents/clients/$(d.clientId)).data;
      return currentLoanReceipt(d) && d.paymentDate >= c.get('approvalDate', '0001-01-01');
    }

    function clientPath(clientId) {
      return /databases/$(database)/documents/clients/$(clientId);
    }

    function trashPath(clientId) {
      return /databases/$(database)/documents/clientTrash/$(clientId);
    }

    function clientPurging(clientId) {
      return !exists(clientPath(clientId)) && exists(trashPath(clientId))
        && get(trashPath(clientId)).data.status == 'purging';
    }

    function restoredClient(clientId) {
      let archived = get(trashPath(clientId)).data;
      return exists(trashPath(clientId)) && !existsAfter(trashPath(clientId))
        && archived.status == 'trashed'
        && request.resource.data.diff(archived.client).affectedKeys().hasOnly(['updatedAt'])
        && request.resource.data.updatedAt == request.time;
    }

    function loanSnapshotMatches(loan, clientId, c) {
      return loan.id == clientId
        && loan.principal == c.principal && loan.interest == c.interest
        && loan.loanTermDays == c.loanTermDays && loan.approvalDate == c.approvalDate
        && loan.transactionNumber == c.get('transactionNumber', '')
        && loan.activeLoanId == c.get('activeLoanId', 'initial')
        && loan.renewalCount == c.get('renewalCount', 0)
        && loan.originalTransactionNumber == c.get('originalTransactionNumber', c.get('transactionNumber', ''))
        && loan.clientNumber == c.get('clientNumber', clientId)
        && loan.firstName == c.get('firstName', '') && loan.lastName == c.get('lastName', '')
        && loan.middleName == c.get('middleName', '') && loan.address == c.get('address', '')
        && loan.cellphone == c.get('cellphone', '');
    }

    function validRenewalRecord(clientId, renewalId) {
      let before = get(clientPath(clientId)).data;
      let after = getAfter(clientPath(clientId)).data;
      let r = request.resource.data;
      return exists(clientPath(clientId)) && existsAfter(clientPath(clientId))
        && r.keys().hasAll(['sequence', 'previousLoan', 'newLoan', 'totalPaid', 'paidOn', 'dueDate', 'newDueDate', 'approvedBy', 'approvedByName', 'notes', 'createdAt'])
        && r.approvedBy == request.auth.uid && r.approvedByName == profile().get('fullName', '')
        && r.createdAt == request.time && r.notes is string && r.notes.size() <= 1500
        && r.sequence == before.get('renewalCount', 0) + 1 && after.renewalCount == r.sequence
        && after.activeLoanId == renewalId && after.transactionNumber == renewalId
        && before.get('activeLoanId', 'initial') != renewalId
        && loanSnapshotMatches(r.previousLoan, clientId, before)
        && loanSnapshotMatches(r.newLoan, clientId, after)
        && r.totalPaid is number && r.totalPaid >= before.principal + before.interest
        && r.paidOn is string && r.paidOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && r.dueDate is string && r.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && r.newDueDate is string && r.newDueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && r.paidOn >= before.approvalDate && r.paidOn <= r.dueDate && r.paidOn <= after.approvalDate
        && r.newDueDate >= after.approvalDate;
    }

    function validRenewalTransition(clientId) {
      let before = resource.data;
      let after = request.resource.data;
      let history = /databases/$(database)/documents/clients/$(clientId)/renewals/$(after.activeLoanId);
      return after.diff(before).affectedKeys().hasOnly(['principal', 'interest', 'loanTermDays', 'approvalDate', 'dailyAmount', 'transactionNumber', 'originalTransactionNumber', 'activeLoanId', 'renewalCount', 'updatedAt'])
        && after.activeLoanId is string && after.activeLoanId.matches('^[0-9]{5}$')
        && after.transactionNumber == after.activeLoanId
        && after.renewalCount == before.get('renewalCount', 0) + 1
        && after.originalTransactionNumber == before.get('originalTransactionNumber', before.get('transactionNumber', ''))
        && validMoney(after.principal) && after.interest is number && after.interest >= 0
        && after.interest <= 999999999 && math.round(after.interest * 100) / 100.0 == after.interest
        && validMoney(after.dailyAmount) && after.loanTermDays in [30, 45, 50, 58]
        && validPaymentDate(after.approvalDate, clientId) && after.updatedAt == request.time
        && !exists(history) && existsAfter(history)
        && getAfter(history).data.approvedBy == request.auth.uid
        && getAfter(history).data.sequence == after.renewalCount;
    }

    // ---- users -------------------------------------------------------------
    match /users/{uid} {
      // Developer profiles stay private except for their owner's sign-in check.
      // Account queries must explicitly select collector/admin roles.
      allow get: if signedIn() && (request.auth.uid == uid
        || (isAdmin() && resource.data.role in ['collector', 'admin']));
      allow list: if isAdmin() && resource.data.role in ['collector', 'admin'];

      // Existing admins provision accounts. Profiles cannot change roles or login emails.
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['role', 'fullName', 'email', 'phone', 'active', 'createdAt'])
        && request.resource.data.keys().hasOnly(['role', 'fullName', 'email', 'phone', 'active', 'createdAt'])
        && request.resource.data.role in ['collector', 'admin']
        && request.resource.data.fullName is string && request.resource.data.fullName.size() > 0
        && request.resource.data.email is string && request.resource.data.email.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && resource.data.role in ['collector', 'admin']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phone', 'active'])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() > 0
        && request.resource.data.get('phone', '') is string
        && request.resource.data.get('active', true) is bool
        && (request.auth.uid != uid || request.resource.data.get('active', true) == true);
      // Enforced here as well as in the UI so direct SDK requests cannot bypass it.
      allow delete: if isAdmin() && request.auth.uid != uid
        && resource.data.role in ['collector', 'admin'];
    }

    // ---- clients ------------------------------------------------------------
    match /clients/{clientId} {
      allow read: if isAdmin() || isActiveCollector();
      allow create: if isAdmin() && ((!exists(trashPath(clientId))
        && !request.resource.data.keys().hasAny(['activeLoanId', 'renewalCount', 'originalTransactionNumber'])) || restoredClient(clientId));
      allow update: if isAdmin() && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeLoanId', 'renewalCount', 'originalTransactionNumber'])
        || validRenewalTransition(clientId));
      // Recycling must preserve the complete original document atomically.
      allow delete: if isAdmin() && existsAfter(trashPath(clientId))
        && getAfter(trashPath(clientId)).data.client == resource.data
        && getAfter(trashPath(clientId)).data.status == 'trashed'
        && getAfter(trashPath(clientId)).data.deletedAt == request.time;
      match /renewals/{renewalId} {
        allow read: if isAdmin();
        allow create: if isAdmin() && validRenewalRecord(clientId, renewalId);
        allow update: if false;
        allow delete: if isAdmin() && clientPurging(clientId);
      }
    }

    // Spark-compatible atomic recycle/restore, with resumable permanent deletion.
    match /clientTrash/{clientId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && exists(clientPath(clientId)) && !existsAfter(clientPath(clientId))
        && request.resource.data.keys().hasOnly(['client', 'trashId', 'deletedAt', 'deletedBy', 'deletedByName', 'status'])
        && request.resource.data.client == get(clientPath(clientId)).data
        && request.resource.data.trashId is string && request.resource.data.trashId.size() > 0
        && request.resource.data.deletedAt == request.time && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.deletedByName == profile().get('fullName', '') && request.resource.data.status == 'trashed';
      allow update: if isAdmin() && !exists(clientPath(clientId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'purgeOperationId'])
        && request.resource.data.status == 'purging' && request.resource.data.purgeOperationId is string
        && (resource.data.status == 'trashed' || (resource.data.status == 'purging'
          && request.resource.data.purgeOperationId == resource.data.purgeOperationId));
      allow delete: if isAdmin() && ((resource.data.status == 'trashed' && existsAfter(clientPath(clientId))
        && getAfter(clientPath(clientId)).data.diff(resource.data.client).affectedKeys().hasOnly(['updatedAt'])
        && getAfter(clientPath(clientId)).data.updatedAt == request.time) || clientPurging(clientId));
    }
    match /clientTrashOperations/{operationId} {
      allow get: if isAdmin();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['operation', 'requestKey', 'actorId', 'status', 'updatedAt'])
        && request.resource.data.operation in ['trash', 'restore', 'purge']
        && request.resource.data.requestKey is string && request.resource.data.actorId == request.auth.uid
        && request.resource.data.status in ['pending', 'complete'] && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['pending', 'complete'] && request.resource.data.updatedAt == request.time;
    }

    // ---- payments (principal repayments) --------------------------------------
    match /payments/{paymentId} {
      allow read: if isAdmin() || isActiveCollector();
      // Collectors can only ADD entries under their own uid; corrections are admin-only.
      allow create: if !exists(/databases/$(database)/documents/receiptDeletions/$(paymentId))
        && request.resource.data.createdAt == request.time && validReceiptFields(request.resource.data) && validCycleReceipt(request.resource.data)
        && (isAdmin() || (isActiveCollector() && isValidNewPayment()));
      allow update: if isAdmin() && validReceiptFields(request.resource.data) && currentLoanReceipt(resource.data)
        && validCycleReceipt(request.resource.data)
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.collectorId == resource.data.collectorId
        && request.resource.data.collectorName == resource.data.collectorName;
      allow delete: if isAdmin() && (clientPurging(resource.data.clientId) || (currentLoanReceipt(resource.data)
        && getAfter(/databases/$(database)/documents/receiptDeletions/$(paymentId)).data.payment == resource.data));
    }

    match /receiptDeletions/{paymentId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && exists(/databases/$(database)/documents/payments/$(paymentId))
        && !existsAfter(/databases/$(database)/documents/payments/$(paymentId))
        && request.resource.data.keys().hasOnly(['clientId', 'payment', 'deletedBy', 'deletedAt'])
        && request.resource.data.payment == get(/databases/$(database)/documents/payments/$(paymentId)).data
        && request.resource.data.clientId == request.resource.data.payment.clientId
        && request.resource.data.deletedBy == request.auth.uid && request.resource.data.deletedAt == request.time;
    }

    match /receiptAudit/{operationId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- holidays (days that do not count toward the loan term) -----------------
    match /holidays/{date} {
      allow read: if isAdmin() || isActiveCollector();
      allow write: if isAdmin();
    }

    function expensesEnabled() {
      let path = /databases/$(database)/documents/settings/Configurations/elements/accountingPolicy;
      return exists(path) && get(path).data.get('expensesEnabled', false) == true;
    }

    function validAccountingPolicy() {
      let d = request.resource.data;
      return d.keys().hasAll(['paymentAllocation', 'expensesEnabled', 'updatedAt', 'updatedBy'])
        && d.keys().hasOnly(['paymentAllocation', 'expensesEnabled', 'updatedAt', 'updatedBy'])
        && d.paymentAllocation in ['principalFirst', 'proportional'] && d.expensesEnabled is bool
        && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }

    function validExpenseDate(value) {
      let parts = value.split('-');
      let year = int(parts[0]);
      let month = int(parts[1]);
      let day = int(parts[2]);
      let date = timestamp.date(year, month, day);
      return value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && date.year() == year && date.month() == month && date.day() == day
        && date <= (request.time + duration.value(8, 'h')).date();
    }

    function validExpenseAssignment(d) {
      let path = /databases/$(database)/documents/clients/$(d.clientId);
      return (d.clientId == '' && d.loanId == '')
        || (d.clientId != '' && exists(path) && get(path).data.get('activeLoanId', 'initial') == d.loanId
          && d.expenseDate >= get(path).data.approvalDate);
    }

    function validExpenseFields(d) {
      return d.keys().hasAll(['categoryId', 'categoryName', 'amount', 'expenseDate', 'description', 'reference',
          'clientId', 'loanId', 'status', 'voidReason', 'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.keys().hasOnly(['categoryId', 'categoryName', 'amount', 'expenseDate', 'description', 'reference',
          'clientId', 'loanId', 'status', 'voidReason', 'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && validMoney(d.amount) && d.expenseDate is string && validExpenseDate(d.expenseDate)
        && d.categoryId is string && d.categoryId.size() > 0 && d.categoryId.size() <= 128
        && d.categoryName is string && d.categoryName.size() > 0 && d.categoryName.size() <= 80
        && d.description is string && d.description.matches('[\\s\\S]*[^ \\t\\r\\n][\\s\\S]*') && d.description.size() <= 500
        && d.reference is string && d.reference.size() <= 120
        && d.clientId is string && d.clientId.size() <= 128 && d.loanId is string && d.loanId.size() <= 128
        && ((d.clientId == '' && d.loanId == '') || (d.clientId != '' && d.loanId != ''))
        && d.status in ['posted', 'void'] && d.voidReason is string && d.voidReason.size() <= 500
        && (d.status == 'posted' ? d.voidReason == '' : d.voidReason.matches('[\\s\\S]*[^ \\t\\r\\n][\\s\\S]*'))
        && d.revision is int && d.revision > 0 && d.createdAt is timestamp && d.createdBy is string
        && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }

    function validPostedExpense(d) {
      let category = /databases/$(database)/documents/expenseCategories/$(d.categoryId);
      return d.status == 'posted' && exists(category) && get(category).data.active == true
        && get(category).data.name == d.categoryName && validExpenseAssignment(d);
    }

    function expenseHistoryMatches(expenseId, d) {
      let path = /databases/$(database)/documents/expenses/$(expenseId)/history/$(string(d.revision));
      return existsAfter(path) && getAfter(path).data == d;
    }

    match /expenseCategories/{categoryId} {
      // The feature switch controls usage, not an administrator's read access.
      // Listeners must remain authorized while an enable/disable save commits.
      allow read: if isAdmin();
      allow create, update: if isAdmin() && expensesEnabled()
        && request.resource.data.keys().hasAll(['name', 'active', 'revision', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['name', 'active', 'revision', 'updatedAt', 'updatedBy'])
        && request.resource.data.name is string && request.resource.data.name.matches('.*[^ \\t\\r\\n].*')
        && request.resource.data.name.size() <= 80 && request.resource.data.active is bool
        && request.resource.data.revision is int
        && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1)
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /expenses/{expenseId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && expensesEnabled() && validExpenseFields(request.resource.data)
        && validPostedExpense(request.resource.data) && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid
        && expenseHistoryMatches(expenseId, request.resource.data);
      allow update: if isAdmin() && expensesEnabled() && validExpenseFields(request.resource.data)
        && resource.data.status == 'posted' && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy
        && (validPostedExpense(request.resource.data)
          || (request.resource.data.status == 'void' && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'voidReason', 'revision', 'updatedAt', 'updatedBy'])))
        && expenseHistoryMatches(expenseId, request.resource.data);
      allow delete: if false;
      match /history/{version} {
        allow read: if isAdmin();
        allow create: if isAdmin() && expensesEnabled()
          && version == string(request.resource.data.revision)
          && getAfter(/databases/$(database)/documents/expenses/$(expenseId)).data == request.resource.data
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid;
        allow update, delete: if false;
      }
    }

    function validIdentifierPolicy() {
      let d = request.resource.data;
      return d.keys().hasAll(['resetWhenEmpty', 'updatedAt', 'updatedBy'])
        && d.keys().hasOnly(['resetWhenEmpty', 'updatedAt', 'updatedBy'])
        && d.resetWhenEmpty is bool && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }

    function validConsolidationMetrics() {
      let d = request.resource.data;
      return d.keys().hasAll(['balance', 'interestCollected', 'expenseAmount', 'netIncome', 'principalReleased', 'cashSurplus', 'updatedAt', 'updatedBy'])
        && d.keys().hasOnly(['balance', 'interestCollected', 'expenseAmount', 'netIncome', 'principalReleased', 'cashSurplus', 'updatedAt', 'updatedBy'])
        && d.balance is bool && d.interestCollected is bool && d.expenseAmount is bool
        && d.netIncome is bool && d.principalReleased is bool && d.cashSurplus is bool
        && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }

    function validLoanSchedulePolicy() {
      let d = request.resource.data;
      return d.keys().hasAll(['skipSundays', 'updatedAt', 'updatedBy'])
        && d.keys().hasOnly(['skipSundays', 'updatedAt', 'updatedBy'])
        && d.skipSundays is bool
        && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }

    // Collectors can get these policies individually, but cannot list shared settings.
    match /settings/Configurations/elements/paymentPolicy {
      allow get: if isAdmin() || isActiveCollector();
    }
    match /settings/Configurations/elements/loanSchedule {
      allow get: if isAdmin() || isActiveCollector();
    }

    // Preserve the existing clients/users/payments/holidays policies above.
    match /settings/{component}/{element=**} {
      allow read, delete: if isAdmin();
      // Overlapping matches grant access with OR, so validate the new policy here.
      allow create, update: if isAdmin()
        && (request.path != /databases/$(database)/documents/settings/Configurations/elements/loanSchedule
          || validLoanSchedulePolicy())
        && (request.path != /databases/$(database)/documents/settings/Configurations/elements/accountingPolicy
          || validAccountingPolicy())
        && (request.path != /databases/$(database)/documents/settings/Configurations/elements/consolidationMetrics
          || validConsolidationMetrics())
        && (request.path != /databases/$(database)/documents/settings/Configurations/elements/identifierPolicy
          || validIdentifierPolicy());
    }

    // Everything else is denied by default.
  }
}
