# Copy this file to ".env" and fill in the values from:
# Firebase Console -> Project settings -> General -> Your apps -> Web app -> SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Enable only after writeReceipt is deployed and tested on the chosen project.
# Rebuild both web and Android; never enable the backendOnly rules gate first.
VITE_RECEIPT_BACKEND=
